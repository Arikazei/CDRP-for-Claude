{
  "description": "Publishes privacy-safe Codex state to the local DiscordRP beacon.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{STARTER}}",
            "commandWindows": "{{STARTER}}",
            "timeout": 2
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{STARTER}}",
            "commandWindows": "{{STARTER}}",
            "timeout": 2
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{STARTER}}",
            "commandWindows": "{{STARTER}}",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{STARTER}}",
            "commandWindows": "{{STARTER}}",
            "timeout": 2
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{STARTER}}",
            "commandWindows": "{{STARTER}}",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{STARTER}}",
            "commandWindows": "{{STARTER}}",
            "timeout": 2
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{STARTER}}",
            "commandWindows": "{{STARTER}}",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
